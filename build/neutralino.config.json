{
  
  "applicationId": "edu.kriptolab.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": [],
  "modes": {
    "window": {
      "title": "KriptoLab - Classic Cipher Tool",
      "width": 1360,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "useSavedState": false
    },
    "cloud": { "url": "/resources/#cloud", "nativeAllowList": [] }
  },
  "cli": {
    "binaryName": "KriptoLab",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0",
    "frontendLibrary": {}
  }
}
